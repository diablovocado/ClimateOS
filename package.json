{
  "name": "climateos",
  "version": "0.1.0",
  "description": "AI-Powered Climate Disaster Intelligence & Response Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"FRONTEND,BACKEND\" -c \"cyan.bold,green.bold\" --kill-others-on-fail \"vite\" \".venv/bin/uvicorn services.main:app --reload --port 8000\"",
    "frontend": "vite",
    "backend": ".venv/bin/uvicorn services.main:app --reload --port 8000",
    "test:backend": ".venv/bin/pytest tests/test_api.py -v"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@rollup/rollup-darwin-arm64": "^4.67.4"
  }
}
